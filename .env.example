# Copy to .env for local development. On Railway, set these as service variables instead.
# Never commit real values.

ENVIRONMENT=development
# The only addresses allowed to call the API: comma-separated frontend URLs (local dev, plus the Vercel
# URL once deployed). A request from anywhere else is refused. Empty refuses every browser request.
AUTHORIZED_URLS=http://localhost:3000
# Shared secret the frontend's server sends with every API call; the same value goes in the frontend's
# API_SECRET. Without it the API refuses everything but /health. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
API_SECRET=

# Supabase: the shared database (Postgres connection string) and sign-in.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: where Supabase publishes its sign-in signing keys. Defaults to
# $SUPABASE_URL/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# Lead Intel user (auth.users id) that ICPs added here are recorded as created by
LEAD_INTEL_ICP_CREATED_BY=

# Claude: research scoring, hooks, emails and email scoring.
ANTHROPIC_API_KEY=
# Optional, these are the defaults.
CLAUDE_SCORING_MODEL=claude-haiku-5-5
# A researched company qualifies when it passes the ICP's rule and scores at least this.
COMPANY_SCORE_THRESHOLD=60

# Providers
APOLLO_API_KEY=
APIFY_TOKEN=
# Google Places API (New), for Search Google Maps on the Companies page. Billed per request.
GOOGLE_PLACES_API_KEY=
# Optional: without a key Jina allows 20 requests/minute, with a free key 500.
JINA_API_KEY=
# Optional: requests per minute to allow Jina. Defaults sit just under its limits.
JINA_RPM=
OPENAI_API_KEY=
# Sending: CheapSequencer runs the campaigns, CheapInboxes the mailboxes and domains.
CHEAPSEQUENCER_API_KEY=
CHEAPINBOXES_API_KEY=
CHEAPSEQUENCER_WEBHOOK_SECRET=

# Background work: Celery workers and Celery beat, with Redis as the broker (Railway's Redis gives REDIS_URL).
REDIS_URL=redis://localhost:6379/0
# Optional: a different broker for Celery. Defaults to REDIS_URL. For local development without Redis
# only: filesystem:// (a folder stands in for the broker; on Windows also pip install pywin32).
CELERY_BROKER_URL=
# How often beat starts the follow-up check, in seconds (60 or more).
FOLLOWUP_CHECK_SECONDS=1800

# Where each outside service is reached. These are the defaults; change one only to go through a proxy
# or a test server.
CHEAPSEQUENCER_API_URL=https://api.cheapsequencer.com/v1
CHEAPINBOXES_API_URL=https://api.cheapinboxes.com
APOLLO_API_URL=https://api.apollo.io/api/v1
APIFY_API_URL=https://api.apify.com/v2
GOOGLE_PLACES_URL=https://places.googleapis.com/v1/places:searchText
JINA_READER_URL=https://r.jina.ai/
# Empty: the Anthropic SDK's default.
ANTHROPIC_BASE_URL=
# Named in the website reader's User-Agent, for site owners who want to know who's reading.
BOT_INFO_URL=https://aheadtech360.com
