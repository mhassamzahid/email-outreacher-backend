# Copy to .env for local development. On Railway, set these as service variables instead.
# Never commit real values.

ENVIRONMENT=development
# Comma-separated list: local Next.js dev server plus the Vercel URL once deployed.
CORS_ORIGINS=http://localhost:3000

# Supabase: the shared database (Postgres connection string) and sign-in.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: where Supabase publishes its sign-in signing keys. Defaults to
# $SUPABASE_URL/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# Lead Intel user (auth.users id) that ICPs added here are recorded as created by
LEAD_INTEL_ICP_CREATED_BY=

# Claude: research scoring, hooks, emails and email scoring.
ANTHROPIC_API_KEY=
# Optional, these are the defaults.
CLAUDE_SCORING_MODEL=claude-haiku-5-5
# A researched company qualifies when it passes the ICP's rule and scores at least this.
COMPANY_SCORE_THRESHOLD=60

# Providers
APOLLO_API_KEY=
APIFY_TOKEN=
# Google Places API (New), for Search Google Maps on the Companies page. Billed per request.
GOOGLE_PLACES_API_KEY=
# Optional: without a key Jina allows 20 requests/minute, with a free key 500.
JINA_API_KEY=
# Optional: requests per minute to allow Jina. Defaults sit just under its limits.
JINA_RPM=
OPENAI_API_KEY=
# Sending: CheapSequencer runs the campaigns, CheapInboxes the mailboxes and domains.
CHEAPSEQUENCER_API_KEY=
CHEAPINBOXES_API_KEY=
CHEAPSEQUENCER_WEBHOOK_SECRET=
